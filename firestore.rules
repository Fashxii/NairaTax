rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // OTP tokens — only readable/writable by Cloud Functions (server-side)
    // No client-side direct access
    match /otp_tokens/{email} {
      allow read, write: if false;
    }

    // Rate limit records — only Cloud Functions can access
    match /otp_rate_limits/{email} {
      allow read, write: if false;
    }

    // User profiles — authenticated users can read their own profile; staff can view users
    match /users/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || request.auth.uid == email || request.auth.token.role in ['super_admin', 'reviewer', 'content_manager']);
      allow write: if false; // Only Cloud Functions can write user profile doc

      // Subcollections (filings, transactions, invoices, employees, wht, notifications, user_settings)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && (request.auth.token.email == email || request.auth.uid == email || request.auth.token.role in ['super_admin', 'reviewer', 'content_manager']);
      }
    }

    // SMTP settings — server-only (Admin SDK bypasses rules)
    match /system_config/{docId} {
      allow read, write: if false;
    }

    // Email audit logs — server-only
    match /email_audit_logs/{docId} {
      allow read, write: if false;
    }
  }
}
