{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", ".env.local"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.map"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net https://www.google.com; frame-src https://www.google.com/recaptcha/ https://nairatax-6128f.firebaseapp.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
        ]
      },
      {
        "source": "/admin**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
        ]
      },
      {
        "source": "/dashboard**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
        ]
      },
      {
        "source": "/verify**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
        ]
      },
      {
        "source": "/compliance**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
        ]
      },
      {
        "source": "/register**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/auth/otp/send",
        "function": "sendOTP"
      },
      {
        "source": "/api/auth/otp/verify",
        "function": "verifyOTP"
      },
      {
        "source": "/api/email/send",
        "function": "sendEmailFn"
      },
      {
        "source": "/api/email/test-smtp",
        "function": "testSMTP"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
