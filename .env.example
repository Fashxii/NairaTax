# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Prisma ORM & PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/nairatax_db?schema=public"

# -----------------------------------------------------------------------------
# MONO OPEN BANKING API CONFIGURATION (Nigeria)
# Obtain keys at: https://dashboard.withmono.co/settings/api-keys
