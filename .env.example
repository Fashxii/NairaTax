# -----------------------------------------------------------------------------
# DIYtax9ja — frontend build-time variables (Vite). Copy to .env.local.
# Never put secrets here: every VITE_* value is embedded in the public bundle.
# Server secrets live in Firebase Secret Manager:
#   firebase functions:secrets:set GMAIL_USER | GMAIL_APP_PASSWORD | OTP_HMAC_KEY | SMTP_ENC_KEY
# -----------------------------------------------------------------------------

# Firebase App Check — reCAPTCHA Enterprise site key (public).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# Local development only: App Check debug token registered in the Firebase console.
VITE_APPCHECK_DEBUG_TOKEN=""
